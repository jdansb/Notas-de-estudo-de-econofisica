key "cockshott2012classical"
literal "false"

\end_inset

 e também no artigo 
\begin_inset Quotes eld
\end_inset

A Emergência da Lei do Valor em uma Economia de Mercadoria Simples e Dinâmica
\begin_inset Quotes erd
\end_inset


\begin_inset CommandInset citation
LatexCommand cite
key "wright2008emergence"
