\begin{align*}
P\left(w,t+1\right) & =\sum_{w-\Delta}P\left(w-\Delta,t\right)Q\left(w-\Delta,w\right)\\
P\left(w,t+1\right) & =P\left(w-\Delta_{R},t\right)Q\left(w-\Delta_{R},w\right)+P\left(w-\Delta_{R}-\frac{w}{2},t\right)Q\left(w-\Delta_{R}-\frac{w}{2},w\right)+P\left(w-\Delta_{R}+w,t\right)Q\left(w-\Delta_{R}+w,w\right)+P\left(w,t\right)Q\left(w,w\right)\\
 & +P\left(w-\Delta_{R}+\frac{w}{2},t\right)Q\left(w-\Delta_{R}+\frac{w}{2},w\right)+P\left(w-\frac{w}{2},t\right)Q\left(w-\frac{w}{2},w\right)+P\left(w+w,t\right)Q\left(w+w,w\right)+P\left(w+\frac{w}{2},t\right)Q\left(w+\frac{w}{2},w\right)\\
P\left(w,t+1\right) & =P\left(w-\Delta_{R},t\right)p_{RLP}+P\left(\frac{w}{2}-\Delta_{R},t\right)p_{RL}+P\left(2w-\Delta_{R},t\right)p_{RP}+P\left(w,t\right)p_{LP}+P\left(\frac{w}{2}-\Delta_{R},t\right)p_{R}+P\left(\frac{w}{2},t\right)p_{L}+P\left(2w,t\right)p_{P}+P\left(\frac{3}{2}w,t\right)p_{0}
\end{align*}

